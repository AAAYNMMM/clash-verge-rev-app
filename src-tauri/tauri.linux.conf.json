{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.aaaynmmm.clash-verge-rev-app",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl", "libayatana-appindicator3-1"],
        "desktopTemplate": "./packages/linux/clash-verge-rev-app.desktop",
        "provides": ["clash-verge-rev-app"],
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      },
      "rpm": {
        "depends": ["openssl", "libayatana-appindicator-gtk3"],
        "recommends": ["policycoreutils", "policycoreutils-python-utils"],
        "desktopTemplate": "./packages/linux/clash-verge-rev-app.desktop",
        "provides": ["clash-verge-rev-app"],
        "postInstallScript": "./packages/linux/post-install-rpm.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      }
    },
    "externalBin": [
      "./sidecar/cvr-app-service",
      "./sidecar/cvr-app-service-install",
      "./sidecar/cvr-app-service-uninstall",
      "./sidecar/cvr-app-mihomo",
      "./sidecar/cvr-app-mihomo-alpha"
    ]
  }
}
