{
  "version": "2.5.13",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "Clash Verge Rev App",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources"],
    "publisher": "Clash Verge Rev App",
    "externalBin": ["sidecar/cvr-app-mihomo", "sidecar/cvr-app-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "Clash Verge Rev App",
    "createUpdaterArtifacts": true,
    "homepage": "https://github.com/AAAYNMMM/clash-verge-rev-app"
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "Clash Verge Rev App",
  "identifier": "io.github.aaaynmmm.clash-verge-rev-app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNjI2MEIxOTAyRjhGQ0MKUldUTWp5K1FzV0JpL0tKcGVSeElDVE96YkYzRnF5bmtVWU9FY2pSdnJrb1pXb1VJallmSHVNVGIK",
      "endpoints": [
        "https://github.com/AAAYNMMM/clash-verge-rev-app/releases/download/updater/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["clash-verge-rev-app"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  },
  "mainBinaryName": "clash-verge-rev-app"
}
